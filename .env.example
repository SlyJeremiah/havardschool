# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
SITE_URL=http://localhost:8000

# PostgreSQL (Neon / Supabase / local). Leave unset locally to use SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/littleharvard?sslmode=require
# DB_SSL_REQUIRE=True

# Backblaze B2 (S3-compatible) for uploaded images. Leave unset to store on local disk.
# B2_BUCKET_NAME=little-harvard-media
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_CUSTOM_DOMAIN=

# Gmail SMTP — use a Google "App Password" (needs 2-Step Verification on)
# EMAIL_HOST_USER=lilharvard5@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# DEFAULT_FROM_EMAIL=Little Harvard ECD Centre <lilharvard5@gmail.com>
SCHOOL_NOTIFY_EMAILS=lilharvard5@gmail.com

# Google Analytics 4 measurement ID
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# First admin account, created during the Vercel build if it doesn't exist yet.
# Add these three temporarily, redeploy, log in, then DELETE them from Vercel.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
